# Production template for Railway (CMS). Never commit real values.
# Paste into Railway → Service → Variables (or `railway variables`).

PAYLOAD_SECRET=
# Must be Postgres. Railway Postgres plugin exposes DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway
PAYLOAD_PUBLIC_SERVER_URL=https://YOUR-CMS.up.railway.app

# After web is live, point publish hook at it:
WEB_REVALIDATE_URL=https://cpa-ngo-web.vercel.app/api/revalidate
REVALIDATE_SECRET=

# Optional R2 (else media is ephemeral on the container filesystem)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_PREFIX=orgs/demo
