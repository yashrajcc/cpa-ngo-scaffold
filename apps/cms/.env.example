# === Local (default) ===
PAYLOAD_SECRET=change-me-to-a-long-random-string
# SQLite — local boot only. Do NOT use file: on Railway / any hosted CMS.
DATABASE_URL=file:./payload.db
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# === Hosted CMS (Railway + Postgres) — copy into Railway Variables ===
# PAYLOAD_SECRET=<openssl rand -base64 32>
# DATABASE_URL=${{Postgres.DATABASE_URL}}   # or postgresql://user:pass@host:5432/railway
# PAYLOAD_PUBLIC_SERVER_URL=https://<your-cms>.up.railway.app
# PORT is set by Railway automatically

# --- Cloudflare R2 (S3 API) — all four required to enable; else local ./media ---
# Endpoint looks like: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Public/custom domain for objects, e.g. https://media.example.org (no trailing slash)
R2_PUBLIC_BASE_URL=
# Object key prefix inside the bucket
R2_PREFIX=orgs/demo

# Publish → revalidate apps/web
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret

# Optional: public Razorpay key id mirrored on OrgProfile in admin
RAZORPAY_KEY_ID=
