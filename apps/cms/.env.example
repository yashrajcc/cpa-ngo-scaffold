PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./payload.db
# Public URL of this CMS (used in seed / CORS notes)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Optional — when unset, media stays on local disk under ./media
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional — web revalidate on publish (apps/web)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret

# Optional Razorpay (CMS may store public key id on OrgProfile; secrets stay server-side on web)
RAZORPAY_KEY_ID=
