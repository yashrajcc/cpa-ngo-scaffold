PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./payload.db
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# --- Cloudflare R2 (S3 API) — all four required to enable; else local ./media ---
# Endpoint looks like: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Public/custom domain for objects, e.g. https://media.example.org (no trailing slash)
R2_PUBLIC_BASE_URL=
# Object key prefix inside the bucket
R2_PREFIX=orgs/demo

# Publish → revalidate apps/web
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret

# Optional: public Razorpay key id mirrored on OrgProfile in admin
RAZORPAY_KEY_ID=
