# === Local ===
CMS_URL=http://localhost:3001
REVALIDATE_SECRET=dev-revalidate-secret

# === Hosted web (Vercel / CF Pages) — set in project env UI ===
# CMS_URL=https://<your-cms>.up.railway.app
# REVALIDATE_SECRET=<same value as CMS REVALIDATE_SECRET>

# --- Razorpay — BOTH required for live/test Checkout; else mock donate ---
# Key ID is public (also set NEXT_PUBLIC_ for client visibility if desired)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
